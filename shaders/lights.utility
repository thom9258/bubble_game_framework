struct HemisphereLight
{
	vec3 ground;
	vec3 sky;
    float intensity;
};	

struct DirectionalLight
{
	vec3 direction;
	vec3 color;
    float intensity;
};	

struct PointLight
{
	vec3 position;
	vec3 color;
    float intensity;
};

vec3 hemisphere_light(HemisphereLight light, vec3 normal)
{
    // Blend from ground to sky based on how much the normal points up
    float t = normal.y * 0.5 + 0.5;
    return mix(light.ground, light.sky, t) * light.intensity;
}

vec3 directional_light(DirectionalLight light, vec3 normal)
{
    float ndl = max(dot(normal, -normalize(light.direction)), 0.0);
    return light.color * light.intensity * ndl;
}

vec3 point_light(PointLight light, vec3 normal, vec3 world_position)
{
    vec3  to_light = light.position - world_position;
    float dist2    = dot(to_light, to_light);
    float ndl      = max(dot(normal, to_light * inversesqrt(dist2)), 0.0);
    // intensity controls both brightness and reach; intensity = 0 turns the slot off
    return light.color * light.intensity * ndl / (1.0 + dist2);
}
